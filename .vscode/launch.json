{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Python File",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "${command:extension.commandvariable.file.relativeFileDotsNoExtension}",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      // "interpreterPath":"$/home/jkobayashi/anaconda3/envs/idea-isax-sw/bin/python"
    },
    {
      "name": "iSAX generate catalog",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "${command:extension.commandvariable.file.relativeFileDotsNoExtension}",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "-start_year", "1994",
        "-stop_year", "2023",
        "-instrument", "omni",
        "-data_path", "/home/jkobayashi/gh_repos/time-series-filter-bank/sw-data/nasaomnireader",
        // "-debug", "10"
        // "-histogram",
        "-cols","F,flow_speed,proton_density"
      ]
    },
    {
      "name": "1day test analysis",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "${command:extension.commandvariable.file.relativeFileDotsNoExtension}",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "-start_year", "1995",
        "-start_month","08",
        "-start_day","04",
        "-cadence", "60",
        "-absolute_residual",
        "-residual_epsilon","0.01",
        "-cols","F,flow_speed"
      ]
    },
    {
      "name": "10 yr test analysis",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "${command:extension.commandvariable.file.relativeFileDotsNoExtension}",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "-start_date", "2008-01-01",
        "-stop_date","2021-01-01",
        // "-chunk_size","315360000",
        "-cadence", "60",
        "-absolute_residual",
        "-residual_epsilon","0.01",
        "-cols","F,flow_speed"
      ]
    },
  ]
}
